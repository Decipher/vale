<?php

/**
 * @file
 * Hooks for testing Vale.
 *
 * Drupal 11.1 and later call ValeTestHooks. Drupal 10 calls the functions
 * marked #[LegacyHook].
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Session\AccountInterface;
use Drupal\vale_test\Hook\ValeTestHooks;

/**
 * Implements hook_entity_type_alter().
 *
 * @param array<string, \Drupal\Core\Entity\EntityTypeInterface> $entity_types
 *   The entity types, keyed by ID.
 */
#[LegacyHook]
function vale_test_entity_type_alter(array &$entity_types): void {
  \Drupal::service(ValeTestHooks::class)->entityTypeAlter($entity_types);
}

/**
 * Implements hook_entity_field_access().
 *
 * @phpstan-param \Drupal\Core\Field\FieldItemListInterface<\Drupal\Core\Field\FieldItemInterface>|null $items
 */
#[LegacyHook]
function vale_test_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  return \Drupal::service(ValeTestHooks::class)->entityFieldAccess($operation, $field_definition, $account, $items);
}
