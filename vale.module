<?php

/**
 * @file
 * Hook implementations for the Vale module.
 *
 * Drupal 11.1 and later call the hook classes in src/Hook directly and skip
 * the functions marked #[LegacyHook]. Drupal 10 calls these functions.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\FieldConfigInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\vale\Hook\ValeEntityHooks;
use Drupal\vale\Hook\ValeFieldUiHooks;
use Drupal\vale\Hook\ValeFormHooks;
use Drupal\vale\Hook\ValeHelpHooks;
use Drupal\vale\Hook\ValeReportHooks;
use Drupal\vale\Hook\ValeViewsHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function vale_help(string $route_name, RouteMatchInterface $route_match): string {
  return \Drupal::service(ValeHelpHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_form_FORM_ID_alter() for field_config_edit_form.
 */
#[LegacyHook]
function vale_form_field_config_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service(ValeFieldUiHooks::class)->fieldConfigEditFormAlter($form, $form_state);
}

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function vale_entity_type_alter(array &$entity_types): void {
  \Drupal::service(ValeEntityHooks::class)->entityTypeAlter($entity_types);
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 */
#[LegacyHook]
function vale_entity_bundle_field_info_alter(array &$fields, EntityTypeInterface $entity_type, string $bundle): void {
  \Drupal::service(ValeEntityHooks::class)->entityBundleFieldInfoAlter($fields, $entity_type, $bundle);
}

/**
 * Implements hook_form_alter().
 */
#[LegacyHook]
function vale_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(ValeFormHooks::class)->formAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_entity_insert().
 */
#[LegacyHook]
function vale_entity_insert(EntityInterface $entity): void {
  \Drupal::service(ValeReportHooks::class)->entityInsert($entity);
}

/**
 * Implements hook_entity_update().
 */
#[LegacyHook]
function vale_entity_update(EntityInterface $entity): void {
  \Drupal::service(ValeReportHooks::class)->entityUpdate($entity);
}

/**
 * Implements hook_entity_delete().
 */
#[LegacyHook]
function vale_entity_delete(EntityInterface $entity): void {
  \Drupal::service(ValeReportHooks::class)->entityDelete($entity);
}

/**
 * Implements hook_entity_revision_delete().
 */
#[LegacyHook]
function vale_entity_revision_delete(EntityInterface $entity): void {
  \Drupal::service(ValeReportHooks::class)->entityRevisionDelete($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for field_config.
 */
#[LegacyHook]
function vale_field_config_update(FieldConfigInterface $field): void {
  \Drupal::service(ValeReportHooks::class)->fieldConfigUpdate($field);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for field_config.
 */
#[LegacyHook]
function vale_field_config_delete(FieldConfigInterface $field): void {
  \Drupal::service(ValeReportHooks::class)->fieldConfigDelete($field);
}

/**
 * Implements hook_views_data().
 */
#[LegacyHook]
function vale_views_data(): array {
  return \Drupal::service(ValeViewsHooks::class)->viewsData();
}
